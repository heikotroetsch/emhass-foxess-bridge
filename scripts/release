#!/usr/bin/env bash
# Cut a release: set the manifest version, roll the changelog, commit, tag.
#   scripts/release 0.2.0          # prepare locally, print the push commands
#   scripts/release 0.2.0 --push   # also push main and the tag
# Pushing the tag starts the Release workflow, which creates the GitHub release
# with the zip HACS installs. A version with a suffix (0.2.0-beta.1) becomes a
# pre-release.
set -e
cd "$(dirname "$0")/.."
VERSION="${1:?usage: scripts/release X.Y.Z [--push]}"
PUSH="${2:-}"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]] || { echo "version must look like 1.2.3 or 1.2.3-beta.1"; exit 1; }
[[ -z "$PUSH" || "$PUSH" == "--push" ]] || { echo "unknown option $PUSH"; exit 1; }
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || { echo "commit or stash your changes first"; exit 1; }
git rev-parse "v${VERSION}" >/dev/null 2>&1 && { echo "tag v${VERSION} exists"; exit 1; }

python3 - "$VERSION" <<'PY'
import json, sys
from datetime import date
from pathlib import Path

version = sys.argv[1]
manifest = Path("custom_components/emhass_foxess_bridge/manifest.json")
data = json.loads(manifest.read_text())
data["version"] = version
manifest.write_text(json.dumps(data, indent=2) + "\n")

changelog = Path("CHANGELOG.md")
text = changelog.read_text()
if "## [Unreleased]" not in text:
    sys.exit("CHANGELOG.md has no '## [Unreleased]' section")
head, _, rest = text.partition("## [Unreleased]")
if not rest.split("## [", 1)[0].strip():
    sys.exit("CHANGELOG.md: the Unreleased section is empty; write what changed first")
text = text.replace(
    "## [Unreleased]",
    f"## [Unreleased]\n\n## [{version}] - {date.today().isoformat()}",
    1,
)
changelog.write_text(text)
PY

scripts/lint >/dev/null
scripts/test -q
git add custom_components/emhass_foxess_bridge/manifest.json CHANGELOG.md
git commit -m "release: v${VERSION}"
git tag -a "v${VERSION}" -m "EMHASS FoxESS Bridge v${VERSION}"
echo
if [[ "$PUSH" == "--push" ]]; then
    git push origin main
    git push origin "v${VERSION}"
    echo "pushed v${VERSION}; the Release workflow is creating the GitHub release:"
    echo "  gh run list --workflow release.yml --limit 1"
else
    echo "tagged v${VERSION}. To publish:"
    echo "  git push origin main && git push origin v${VERSION}"
fi
