# Copy to .env (git-ignored). Used by scripts/deploy and the real-system scripts.
HA_URL=http://homeassistant.local:8123
# Long-lived access token (profile > security) for deploy restarts and recordings.
HA_TOKEN=
HA_SSH_HOST=hassio@homeassistant.local
# Only needed to configure ha-foxess-openapi through its config flow by script.
FOX_API_KEY=
FOX_DEVICE_SN=
# Local time zone of the inverter, for the write-cycle safety check.
FOX_TIME_ZONE=Europe/Berlin
# Set to 1 only when you deliberately run scripts/write_cycle.py.
FOX_ALLOW_WRITES=0
